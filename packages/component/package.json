{
  "name": "component",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:compile": "tsc",
    "build:pkg": "exports \"./lib/**/*\" --wrappers",
    "build": "npm run build:compile && npm run build:pkg",
    "dev:compile": "tsc --watch",
    "dev:pkg": "exports \"./lib/**/*\" --watch --wrappers",
    "dev": "run -p dev:compile dev:pkg"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@atomico/react": "*",
    "@atomico/wrapper": "^2.0.1",
    "atomico": "*"
  },
  "devDependencies": {
    "@atomico/exports": "^2.0.0",
    "@atomico/run": "^0.14.2",
    "@atomico/tsconfig": "latest",
    "typescript": "^5.9.3"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./react": {
      "types": "./wrapper/react.d.ts",
      "default": "./wrapper/react.js"
    },
    "./react/next": {
      "types": "./wrapper/react/next.d.ts",
      "default": "./wrapper/react/next.js"
    }
  },
  "peerDependencies": {
    "@atomico/react": "*"
  },
  "peerDependenciesMeta": {
    "@atomico/react": {
      "optional": true
    }
  }
}
