{
  "name": "@atomico/react",
  "version": "3.1.0-beta",
  "type": "module",
  "description": "",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:compile": "tsc",
    "build:pkg": "exports \"./lib/**/*\"",
    "build": "npm run build:compile && npm run build:pkg",
    "prepublishOnly": "npm run build"
  },
  "author": "UpperCod",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/atomicojs/react/issues"
  },
  "homepage": "https://github.com/atomicojs/react#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/atomicojs/react.git"
  },
  "keywords": [
    "jsx",
    "web-components",
    "custom-elements",
    "webcomponent",
    "react",
    "preact"
  ],
  "devDependencies": {
    "@atomico/exports": "^2.0.0",
    "@atomico/tsconfig": "latest",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@atomico/wrapper": "^2.0.1",
    "@types/react": "latest",
    "atomico": "^2.0.0||^2.1.0-beta",
    "react": "latest"
  },
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./wrapper": {
      "types": "./lib/wrapper.d.ts",
      "default": "./lib/wrapper.js"
    }
  }
